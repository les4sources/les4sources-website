---
import type { GetStaticPaths } from "astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import CardGrid, { type CardItem } from "@components/ui/CardGrid.astro";
import Gallery from "@components/ui/Gallery.astro";
import PageHero from "@components/ui/PageHero.astro";
import Prose from "@components/ui/Prose.astro";
import ReservationBand from "@components/ui/ReservationBand.astro";
import Badge from "@components/ds/Badge.astro";
import Section from "@components/ds/Section.astro";
import { byPath, pathOf, visible } from "@lib/content";
import { breadcrumbs } from "@lib/seo";
import { site } from "@lib/site";

/**
 * Hébergements — arborescence imbriquée (gîte › chambre), donc route attrape-tout.
 * Chaque niveau du chemin d'origine est préservé tel quel.
 */
const BASE = "/sejours/hebergements-yvoir";

export const getStaticPaths: GetStaticPaths = async () => {
  // `getStaticPaths` est hissée dans son propre module par Astro : elle ne voit
  // pas les constantes du frontmatter, d'où la répétition du préfixe ici.
  const base = "/sejours/hebergements-yvoir";
  const entries = visible(await getCollection("hebergements"));
  return entries
    .filter((entry) => pathOf(entry).startsWith(`${base}/`))
    .map((entry) => ({
      params: { slug: pathOf(entry).slice(base.length + 1) },
      props: { entry },
    }));
};

interface Props {
  entry: CollectionEntry<"hebergements">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const here = pathOf(entry);
const rest = here.slice(BASE.length + 1).split("/");
// Un gîte est au premier niveau ; ce qui est plus profond est une pièce.
const isLodging = rest.length === 1;

const all = visible(await getCollection("hebergements"));
// Enfants DIRECTS seulement : `<ici>/<un-seul-segment>`. Sans ce garde-fou, les
// chambres rangées sous une page intermédiaire (`…/la-hulotte-photos/…`)
// remontaient une seconde fois dans « Les espaces ».
const children = all
  .filter((e) => {
    const p = pathOf(e);
    return p.startsWith(`${here}/`) && !p.slice(here.length + 1).includes("/");
  })
  .sort((a, b) => a.data.title.localeCompare(b.data.title, "fr"));
const parent = isLodging ? undefined : byPath(all, here.slice(0, here.lastIndexOf("/")));

const childItems: CardItem[] = children.map((c) => ({
  title: c.data.title,
  href: pathOf(c),
  // Une description fabriquée ne s'affiche pas : elle ne sert que le SEO.
  description: c.data.generatedDescription ? undefined : c.data.description,
  icon: c.data.icon,
  image: c.data.cover,
}));

// Les pages pratiques réellement publiées — leur libellé vient de leur titre.
const pages = visible(await getCollection("pages"));
const practical = ["/sejours/tarifs", "/sejours/disponibilites", "/sejours/regles-du-lieu", "/sejours/conditions"]
  .map((path) => {
    const page = byPath(pages, path);
    return page ? { label: page.data.title, href: path } : undefined;
  })
  .filter((l): l is { label: string; href: string } => Boolean(l));

// Fil d'Ariane : Accueil › Séjours › Les hébergements › (chaque niveau) › page
const crumbs = [
  { label: "Accueil", href: "/" },
  { label: "Séjours", href: "/sejours" },
  { label: "Les hébergements", href: BASE },
  ...rest.map((seg, i) => ({
    label: i === rest.length - 1 ? d.title : seg.replace(/-/g, " "),
    href: `${BASE}/${rest.slice(0, i + 1).join("/")}`,
  })),
];

const siteUrl = (Astro.site ?? new URL(site.url)).href.replace(/\/$/, "");
const jsonld = [breadcrumbs(crumbs.map((c) => ({ name: c.label, url: `${siteUrl}${c.href}` })))];
---

<BaseLayout
  title={d.seoTitle ?? d.title}
  description={d.description}
  ogImage={d.cover ?? d.ogImage}
  noindex={d.noindex}
  jsonld={jsonld}
>
  <PageHero
    title={d.title}
    lead={d.generatedDescription ? undefined : d.description}
    cover={d.cover}
    coverAlt={d.coverAlt}
    icon={d.icon}
    pole={d.pole ?? "hebergement"}
    crumbs={crumbs}
    narrow={!isLodging}
  />

  {
    isLodging ? (
      <Section class="pt-10">
        <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_280px]">
          <div data-lightbox-scope>
            {d.capacity && (
              <p class="mb-6">
                <Badge tone="teal">{d.capacity} personnes</Badge>
              </p>
            )}

            <Prose width="full">
              <Content />
            </Prose>

            {d.gallery.length > 0 && (
              <Gallery images={d.gallery} alt={d.title} class="mt-12" />
            )}
          </div>

          <aside class="h-fit lg:sticky lg:top-24">
            <div class="rounded-photo bg-paper p-6">
              <h2 class="font-display text-h4 font-bold">Infos pratiques</h2>
              <ul class="mt-4 flex list-none flex-col gap-3 p-0">
                {practical.map((link) => (
                  <li>
                    <a href={link.href} class="font-ui text-ui font-semibold text-teal">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        </div>

        {children.length > 0 && (
          <div class="mt-16">
            <h2 class="mb-7 font-display text-h2 font-bold">Les espaces 🛏️</h2>
            <CardGrid items={childItems} />
          </div>
        )}
      </Section>
    ) : (
      <Section narrow class="pt-10">
        <Prose width="full">
          <Content />
        </Prose>

        {parent && (
          <p class="mt-10">
            <a href={pathOf(parent)} class="font-ui text-ui font-semibold text-teal">
              ← {parent.data.title}
            </a>
          </p>
        )}
      </Section>
    )
  }

  {isLodging && <ReservationBand />}
</BaseLayout>
