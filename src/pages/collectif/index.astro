---
import { getCollection, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/ui/PageHero.astro";
import Prose from "@components/ui/Prose.astro";
import CardGrid, { type CardItem } from "@components/ui/CardGrid.astro";
import { byPath, visible, listable, pathOf } from "@lib/content";

/**
 * /collectif — la page éditoriale migrée fait foi (son texte et ses liens sont
 * ceux du site actuel) ; la grille des fiches, elle, vient de la collection
 * typée `collectif`, pas d'une liste en dur.
 */
const pages = visible(await getCollection("pages"));
const entry = byPath(pages, "/collectif");
const rendered = entry ? await render(entry) : undefined;
const Content = rendered?.Content;

const members = listable(await getCollection("collectif")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, "fr"),
);

const items: CardItem[] = members.map((m) => ({
  title: m.data.name,
  href: pathOf(m),
  description: m.data.description,
  eyebrow: m.data.role,
  icon: m.data.icon,
  pole: m.data.pole,
}));

const title = entry?.data.title ?? "Le collectif des 4 Sources";
const description =
  entry?.data.description ??
  "Les habitant·es et compagnon·nes qui font vivre le tiers-lieu des 4 Sources, à Yvoir.";
---

<BaseLayout
  title={entry?.data.seoTitle ?? title}
  description={description}
  ogImage={entry?.data.cover ?? entry?.data.ogImage}
  noindex={entry?.data.noindex ?? false}
>
  <PageHero
    title={title}
    lead={entry?.data.description}
    cover={entry?.data.cover}
    coverAlt={entry?.data.coverAlt}
    icon={entry?.data.icon}
    crumbs={[{ label: "Accueil", href: "/" }, { label: "Le collectif" }]}
  />

  <div class="mx-auto max-w-[1180px] px-[clamp(16px,4vw,44px)] py-[clamp(32px,6vw,72px)]">
    {Content && <Prose><Content /></Prose>}

    <section aria-labelledby="membres" class={Content ? "mt-14" : ""}>
      <h2 id="membres" class="mb-6">Les fiches du collectif</h2>
      <CardGrid items={items} empty="Les fiches du collectif arrivent bientôt." />
    </section>
  </div>
</BaseLayout>
