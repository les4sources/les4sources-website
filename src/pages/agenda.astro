---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Lead from "@components/ds/Lead.astro";
import Section from "@components/ds/Section.astro";
import Tag from "@components/ds/Tag.astro";
import AgendaTabs from "@components/home/AgendaTabs.astro";
import EventGrid from "@components/home/EventGrid.astro";
import { categoriesOf, eventItems } from "@components/home/events";
import { byPath, pastEvents, upcomingEvents, visible } from "@lib/content";

/**
 * /agenda — d'après `design/ui_kits/Agenda.jsx` : titre, chapeau, onglets
 * « À venir / Passés », filtres par thématique, grille de trois colonnes.
 * Les onglets et les filtres sont progressifs : sans JavaScript, tout
 * s'affiche et rien n'est perdu.
 */
const pages = visible(await getCollection("pages"));
const entry = byPath(pages, "/agenda");

const events = await eventItems();
// Une fiche sans date ne peut pas figurer dans un agenda : elle reste servie
// à son URL, mais la grille des rendez-vous ne montre que des dates réelles.
const upcoming = upcomingEvents(events).filter((e) => Boolean(e.start));
const past = pastEvents(events);
const categories = categoriesOf(upcoming);

const title = entry?.data.title ?? "L’agenda des 4 Sources";
const icon = entry?.data.icon;
const description = entry?.data.description ?? "Viens nous rencontrer lors de nos prochains événements !";
---

<BaseLayout
  title={entry?.data.seoTitle ?? title}
  description={description}
  ogImage={entry?.data.cover ?? entry?.data.ogImage}
  noindex={entry?.data.noindex ?? false}
>
  <Section narrow class="pb-6">
    <h1 class="mb-3 font-display text-h1 font-bold">{icon ? `${title} ${icon}` : title}</h1>
    <Lead>Viens nous rencontrer lors de nos prochains événements !</Lead>
  </Section>

  <Section class="pt-0">
    <AgendaTabs upcomingLabel="À venir" pastLabel="Passés">
      <Fragment slot="upcoming">
        <div data-filter-root>
          {
            categories.length > 1 && (
              <div class="mb-8 flex flex-wrap gap-2">
                <Tag selected data-filter="*">
                  Tous
                </Tag>
                {categories.map((c) => (
                  <Tag data-filter={c}>{c}</Tag>
                ))}
              </div>
            )
          }

          <EventGrid items={upcoming} cols={3} />
        </div>

      </Fragment>

      <Fragment slot="past">
        <EventGrid items={past} cols={3} withImages={false} />
      </Fragment>
    </AgendaTabs>
  </Section>
</BaseLayout>

<script>
  // Filtre par thématique — progressif : sans JS, toutes les cartes restent là.
  document.querySelectorAll<HTMLElement>("[data-filter-root]").forEach((root) => {
    const tags = Array.from(root.querySelectorAll<HTMLElement>("[data-filter]"));
    const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-event]"));
    if (tags.length === 0) return;

    const paint = (active: HTMLElement) => {
      for (const tag of tags) {
        const on = tag === active;
        tag.setAttribute("aria-pressed", on ? "true" : "false");
        tag.classList.toggle("border-teal", on);
        tag.classList.toggle("bg-teal", on);
        tag.classList.toggle("text-white", on);
        tag.classList.toggle("border-line", !on);
        tag.classList.toggle("bg-white", !on);
        tag.classList.toggle("text-ink", !on);
      }
    };

    for (const tag of tags) {
      tag.addEventListener("click", () => {
        const value = tag.dataset.filter ?? "*";
        paint(tag);
        for (const card of cards) {
          const cats = (card.getAttribute("data-categories") ?? "").split("|");
          card.hidden = value !== "*" && !cats.includes(value);
        }
      });
    }
  });
</script>
