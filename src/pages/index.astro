---
import Photo from "@components/ui/Photo.astro";
import Slideshow from "@components/ui/Slideshow.astro";
import { getCollection, getEntry } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/ds/Button.astro";
import Card from "@components/ds/Card.astro";
import Highlight from "@components/ds/Highlight.astro";
import Lead from "@components/ds/Lead.astro";
import Section from "@components/ds/Section.astro";
import EventGrid from "@components/home/EventGrid.astro";
import HeroSplit from "@components/home/HeroSplit.astro";
import { activityByPath, eventItems } from "@components/home/events";
import { byPath, upcomingEventsWithin, visible } from "@lib/content";

import cover from "@assets/migration/index/01-dji_fly_20260425_162224_848_1777127142778_photo_optimized.jpg";
import photoBar from "@assets/migration/le-bar-des-4-sources/04-2g0a1417.jpg";
import photoPrairie from "@assets/migration/sejours/06-20250719_150904_3017005B_-1.jpg";
import photoPizzaParty from "@assets/migration/evenements__pizza-party-juin-2026/03-508613796_1023903979919038_8286032347514294983_n.jpg";
import photoVallee from "@assets/migration/a-propos/04-bf56a13f-8f8c-4069-bbc7-829dfc79be7d.jpg";
import photoRecolte from "@assets/migration/catalogue__chantier-participatif/02-c4d3d572-0fe2-495d-ae66-6244b2bb653a.jpg";
import photoChambre from "@assets/migration/index/08-5b02a02e-c20f-46c8-9763-bbe82859cff4.jpg";
import photoGrandeSalle from "@assets/migration/sejours__salles/06-baafa39c-6519-476e-a909-bbeb55345a8a.jpg";
import photoPetiteSalle from "@assets/migration/sejours__salles/07-location-salle-reunion-yvoir.jpg";
import photoCercle from "@assets/migration/sejours__salles/03-location-salle-fete-yvoir.jpg";
import semisto from "@assets/migration/index/09-semisto.jpg";
import branches from "@assets/migration/index/10-de-branches-en-planches.jpg";
import pain from "@assets/migration/index/11-pain.jpg";
import soutienWallonie from "@assets/migration/index/16-WR-complete-inblock-positif.png";
import soutienCyrys from "@assets/migration/index/17-fondation-cyrys.png";

/**
 * L'accueil, composé section par section d'après `design/ui_kits/Home.jsx`,
 * revu avec Michael le 2026-09-08 : le hero appelle à l'action, la grille
 * « Prochainement » montre les rendez-vous datés des deux prochains mois
 * (Claudy + collections), la Guinguette, la liste en dur et la grappe de liens
 * de l'ancien site sont retirées, et sous 640 px les cartes défilent
 * horizontalement. Le texte restant est celui de la page migrée
 * (`src/content/pages/index.md`), au mot près ; le sous-titre du hero et les
 * libellés des boutons viennent de la maquette et des pages existantes.
 */
const pages = visible(await getCollection("pages"));
const entry = byPath(pages, "/");
if (!entry) {
  throw new Error(
    'Aucune entrée `pages` avec legacyPath "/" — l\'accueil ne peut pas être rendu. ' +
      "Vérifie src/content/pages/index.md.",
  );
}
const d = entry.data;

/** Les rendez-vous datés des deux prochains mois, du plus proche au plus lointain. */
const upcoming = upcomingEventsWithin(await eventItems(), 2);

/** La fiche Pizza Party du catalogue prête sa photo à la section des groupes. */
const pizzaParty = await activityByPath("/catalogue/pizza-ou-camembert-party");
/** Sa réservation passe par la page Pizza Party privée de Tranches de Vie. */
const pizzaBookingUrl = (await getEntry("catalogue", "pizza-ou-camembert-party"))?.data.bookingUrl;

// Les trois activités mises en avant par la page migrée, avec leur photo de fiche.
const featured = await Promise.all(
  [
    { label: "🫏 Bain d’ânes", path: "/catalogue/temps-avec-le-troupeau-d-anes" },
    { label: "🪢 Grimpe encadrée dans les arbres", path: "/catalogue/grimpe-encadree-dans-les-arbres" },
    { label: "🤾🏻‍♂️ Initiation au Disc-golf", path: "/catalogue/initiation-au-disc-golf" },
  ].map(async (a) => ({ ...a, item: await activityByPath(a.path) })),
);
---

<BaseLayout
  title={d.seoTitle ?? d.title}
  description={d.description}
  ogImage={d.cover ?? d.ogImage}
  noindex={d.noindex}
>
  <HeroSplit
    overline="Les 4 Sources à Yvoir"
    title="Lieu d’activités, de nature et de vie collective"
    lead="Tiers-lieu dans la clairière, entre Namur et Dinant."
    photos={[
      {
        src: cover,
        alt: d.coverAlt ?? "Les 4 Sources vues du ciel, dans leur clairière",
        // Le cadre est plus haut que large sur ordinateur : on garde le bâtiment, à droite.
        position: "95% 50%",
      },
      { src: photoBar, alt: "Le Bar des 4 Sources et sa terrasse" },
      { src: photoPrairie, alt: "Un groupe dans la prairie, au pied de la forêt" },
    ]}
  >
    <Fragment slot="actions">
      <Button variant="primary" size="lg" href="/sejours">Séjours et locations</Button>
      <Button variant="secondary" size="lg" href="/agenda">L’agenda des 4 Sources</Button>
    </Fragment>
  </HeroSplit>

  <Section
    overline="Le lieu"
    title="Un lieu de nature, d’habitat collectif et d’activités"
    align="center"
    surface="paper"
  >
    <div class="l4s-rows">
      <article class="l4s-row">
        <Image src={photoPizzaParty} alt="Une Pizza Party en terrasse, devant le Bar des 4 Sources" widths={[480, 720, 1080]} sizes="(min-width: 900px) 600px, 100vw" class="l4s-row-photo" />
        <div>
          <h3>Lieu d’activités</h3>
          <p>
            Un lieu où vivre des expériences innovantes et inspirantes en famille, entre ami·e·s ou
            entre collègues.
          </p>
          <a href="/activites" class="l4s-arrowlink">Nos activités</a>
        </div>
      </article>
      <article class="l4s-row">
        <Image src={photoVallee} alt="La vallée boisée autour des 4 Sources" widths={[480, 720, 1080]} sizes="(min-width: 900px) 600px, 100vw" class="l4s-row-photo" />
        <div>
          <h3>Lieu de nature</h3>
          <p>
            Une clairière de 15 hectares où l’accueil de la biodiversité fait partie intégrante de
            l’ADN du projet.
          </p>
          <a href="/biodiversite" class="l4s-arrowlink">La biodiversité aux 4 Sources</a>
        </div>
      </article>
      <article class="l4s-row">
        <Image src={photoRecolte} alt="Des mains ramassent des pommes à la récolte du verger" widths={[480, 720, 1080]} sizes="(min-width: 900px) 600px, 100vw" class="l4s-row-photo" />
        <div>
          <h3>Lieu de vie collective</h3>
          <p>
            Un tiers-lieu sur lequel <a href="/projets">différents projets</a> se déploient et où 5
            foyers sont installés.
          </p>
          <a href="/notre-collectif" class="l4s-arrowlink">Découvre notre collectif</a>
        </div>
      </article>
    </div>
  </Section>

  <Section overline="Agenda" title="Prochainement aux 4 Sources ⛅" highlight="Prochainement" align="center">
    {upcoming.length > 0 && <EventGrid items={upcoming} cols={4} snap expire />}

    <div class:list={["flex justify-center", upcoming.length > 0 && "mt-9"]}>
      <Button variant="secondary" href="/agenda">L’agenda des 4 Sources</Button>
    </div>
  </Section>

  <Section overline="Séjours" title="Hébergements, salles polyvalentes et cuisine professionnelle 🏡" highlight="Hébergements" align="center" surface="paper">
    <div class="grid grid-cols-1 items-center gap-10 md:grid-cols-[1.1fr_1fr] md:gap-12">
      <Slideshow
        slides={[
          { src: photoChambre, alt: "Une chambre d’un gîte des 4 Sources" },
          { src: photoGrandeSalle, alt: "La grande salle, sous la charpente de l’ancienne grange" },
          { src: photoPetiteSalle, alt: "La petite salle installée pour une réunion" },
          { src: photoCercle, alt: "Un grand cercle réuni dans la grande salle" },
        ]}
        sizes="(min-width: 768px) 560px, 100vw"
        label="Choisir une photo des hébergements et des salles"
      />

      <div>
        <Lead class="mb-5">
          Nos nombreux espaces accueillent tes séjours et activités entre collègues, entre amis ou
          tout simplement en famille.
        </Lead>

        <ul class="m-0 mb-6 grid list-disc gap-2 pl-6 font-body text-body">
          <li>
            <b><a href="/sejours/hebergements-yvoir">2 gîtes</a></b> pouvant accueillir jusqu’à 23 personnes
          </li>
          <li><b><a href="/sejours/salles">une grande salle</a></b> pour 30 à 80 personnes</li>
          <li><b><a href="/sejours/salles">une petite salle</a></b> pour 10 à 30 personnes</li>
          <li>une <b><a href="/sejours/salles">cuisine professionnelle</a></b></li>
          <li><b><a href="/sejours/bivouac">un bivouac</a></b> pour tentes et hamacs</li>
        </ul>

        <Button variant="primary" href="/sejours">Toutes nos locations</Button>
      </div>
    </div>
  </Section>

  <Section overline="Vie collective" title="Nos projets 🎴" highlight="projets" align="center">
    <Lead class="mx-auto -mt-4 mb-10 max-w-[52ch] text-center">Aux 4 Sources émergent des projets plein de sens aux valeurs partagées.</Lead>

    <div class="l4s-snap-row sm:grid sm:grid-cols-2 sm:gap-5 lg:grid-cols-3">
      <Card hoverable image={semisto} imageAlt="Semisto" imageAspect="16/10">
        <h3 class="mb-2 font-display text-h4 font-bold">
          <a
            href="/projets/semisto"
            class="l4s-stretch-link text-inherit no-underline hover:text-teal-soft">Semisto</a
          >
        </h3>
        <p class="font-body text-small text-ink-2">
          Un collectif au service de celles et ceux qui rêvent de jardins-forêts : bureau d’études,
          formations et pépinière-école
        </p>
      </Card>

      <Card hoverable image={branches} imageAlt="De branches en planches" imageAspect="16/10">
        <h3 class="mb-2 font-display text-h4 font-bold">
          <a
            href="/projets/de-branches-en-planches"
            class="l4s-stretch-link text-inherit no-underline hover:text-teal-soft"
            >De Branches en Planches</a
          >
        </h3>
        <p class="font-body text-small text-ink-2">
          Magnifier n’importe quel morceau de bois pour faire du beau, de l’utile et du durable
        </p>
      </Card>

      <Card hoverable image={pain} imageAlt="Pain" imageAspect="16/10">
        <h3 class="mb-2 font-display text-h4 font-bold">
          <a
            href="/projets/tranches-de-vie"
            class="l4s-stretch-link text-inherit no-underline hover:text-teal-soft">Tranches de Vie</a
          >
        </h3>
        <p class="font-body text-small text-ink-2">
          De délicieux pains au levain cuits au feu de bois tous les vendredis
        </p>
      </Card>
    </div>

    <div class="mt-9 flex justify-center">
      <Button variant="secondary" href="/projets">Tous les projets</Button>
    </div>
  </Section>

  <Section title="Randonneur ou cycliste de passage ? 🚵🏻" surface="teal">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <div>
        <h3 class="mb-2.5 font-display text-h3 font-bold">
          <Highlight thickness={1}>Le Bar des 4 Sources</Highlight>
        </h3>
        <p class="font-body text-body text-white/90">
          Le bar des 4 Sources accueille les marcheur·euse·s et cyclistes du lever au coucher du
          soleil, ainsi que toutes les personnes de passage sur le lieu pour une activité ou une
          location.
        </p>
        <div class="mt-5">
          <Button variant="highlight" href="/le-bar-des-4-sources">Découvrir le bar</Button>
        </div>
      </div>

      <div>
        <h3 class="mb-2.5 font-display text-h3 font-bold text-white">Carte de balades</h3>
        <p class="font-body text-body text-white/90">
          Télécharge notre carte de randonnées au départ des 4 Sources, avec des balades et randos
          adaptées aux familles et aux aventuriers.
        </p>
        <div class="mt-5">
          <Button variant="inverse" href="/carte-de-balades-vallee-du-bocq">Télécharger la carte</Button>
        </div>
      </div>
    </div>
  </Section>

  <Section overline="Groupes" title="Nos activités pour groupes 👥" highlight="activités" align="center" surface="paper">
    <div class="grid grid-cols-1 items-center gap-10 md:grid-cols-[1fr_1.4fr] md:gap-12">
      {
        pizzaParty?.cover && (
          <Photo
            src={pizzaParty.cover}
            alt="Pizza Party aux 4 Sources"
            widths={[480, 720, 960]}
            sizes="(min-width: 768px) 470px, 100vw"
            class="block aspect-[4/3] w-full rounded-photo object-cover"
          />
        )
      }

      <div>
        <h3 class="mb-2.5 font-display text-h4 font-bold">
          🍕 <a href="/catalogue/pizza-ou-camembert-party">Une Pizza Party pour ton groupe ?</a>
        </h3>
        <p class="font-body text-body">
          C’est possible le mardi soir et le vendredi soir aux 4 Sources ! Par temps plus frais,
          couple ta Pizza Party privée avec la location de notre petite salle !
        </p>
        <p class="mt-2.5 font-body text-body">
          Révise ton italien et viens chanter Eros Ramazzotti en cuisant de délicieuses pizzas avec
          tes amis ou ta famille dans notre four à bois.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          {
            pizzaBookingUrl && (
              <Button variant="primary" href={pizzaBookingUrl} rel="noopener">
                Réserver ma Pizza Party privée
              </Button>
            )
          }
          <Button variant="secondary" href="/catalogue/camembert-party"
            >Existe aussi en Camembert Party !</Button
          >
        </div>
      </div>
    </div>

    <div class="mt-12">
      <p class="mb-3 font-body text-body">
        Nous te proposons <b>une série d’activités passionnantes</b> pour tes…
      </p>
      {/* Retrait suspendu : la 2e ligne d'un élément s'aligne sur le texte, pas sous la coche. */}
      <ul class="m-0 grid list-none gap-2 p-0 font-body text-body sm:grid-cols-2 lg:grid-cols-3 [&>li]:-indent-[1.55em] [&>li]:pl-[1.55em]">
        <li>✔️ <a href="/sejours/retraites-scolaires">Retraites scolaires</a></li>
        <li>✔️ <a href="/mariage-champetre">Mariages</a></li>
        <li>✔️ <a href="/sejours/mises-au-vert">Mises au vert</a> (associations et entreprises)</li>
        <li>✔️ <a href="/un-team-building-aux-4-sources">Team buildings</a></li>
        <li>
          ✔️ <a href="/sejours/en-famille-aux-4-sources">Week-ends familiaux et entre amis</a>
        </li>
        <li>✔️ <a href="/coworking">Coworking</a></li>
      </ul>
      <div class="mt-6">
        <Button
          variant="secondary"
          href="/activites"
          class="h-auto! max-w-full whitespace-normal! py-2.5 text-center leading-snug"
          >Tout le catalogue d’ateliers pour groupes</Button
        >
      </div>
    </div>

    <div class="mt-12">
      <p class="l4s-overline mb-4">Catalogue des activités</p>
      <div class="l4s-snap-row sm:grid sm:grid-cols-3 sm:gap-5">
        {
          featured.map((a) => (
            <Card
              hoverable
              image={a.item?.cover}
              imageAlt={a.label}
              imageAspect="16/10"
              pole={a.item?.pole}
              padding={16}
            >
              <p class="font-display text-h4 font-bold">
                <a
                  href={a.path}
                  class="l4s-stretch-link text-inherit no-underline hover:text-teal-soft"
                >
                  {a.label}
                </a>
              </p>
            </Card>
          ))
        }
      </div>
    </div>
  </Section>

  {/* Sur blanc et centrés, comme les autres en-têtes de section : la bande qui
      suit est celle de la newsletter, sur fond teinté. */}
  <Section title="Nos soutiens 💚" highlight="soutiens" align="center" class="border-t-[1.5px] border-line-soft">
    <div class="flex flex-wrap items-center justify-center gap-x-14 gap-y-8 sm:gap-x-20">
      <Image
        src={soutienWallonie}
        alt="Wallonie Relance"
        widths={[240, 300]}
        sizes="120px"
        class="h-auto max-h-[120px] w-auto object-contain"
      />
      <Image
        src={soutienCyrys}
        alt="Fondation Cyrys"
        widths={[240, 300]}
        sizes="120px"
        class="h-auto max-h-[120px] w-auto object-contain"
      />
    </div>
  </Section>
</BaseLayout>
