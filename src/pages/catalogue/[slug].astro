---
import { displayDescription, seoDescription } from "@lib/text";
import { activityByPath } from "@components/home/events";
import { claudyImage } from "@lib/remote-image";
import type { GetStaticPaths } from "astro";
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import CardGrid, { type CardItem } from "@components/ui/CardGrid.astro";
import Facts from "@components/ui/Facts.astro";
import PageHero from "@components/ui/PageHero.astro";
import Prose from "@components/ui/Prose.astro";
import Button from "@components/ds/Button.astro";
import Section from "@components/ds/Section.astro";
import { siteData } from "@lib/data";
import { isPole } from "@lib/poles";
import { breadcrumbs } from "@lib/seo";
import { site } from "@lib/site";
import type { MergedExperience } from "@lib/claudy";

/** Fiche d'activité — Claudy fait foi, la fiche migrée sert de repli. */
export const getStaticPaths: GetStaticPaths = async () => {
  const { experiences } = await siteData();
  return experiences
    .filter((x) => x.path.startsWith("/catalogue/"))
    .map((x) => ({ params: { slug: x.slug }, props: { experience: x } }));
};

interface Props {
  experience: MergedExperience;
}

const { experience } = Astro.props;

/**
 * Fiches retirées (statut « Indisponible ») : l'URL reste servie — c'est un
 * contrat —, mais hors index. Quand une fiche active la remplace, elle devient
 * la canonique : les moteurs reportent sur elle ce que l'ancienne avait acquis.
 */
const SUCCESSORS: Record<string, string> = {
  chantier: "/catalogue/chantier-participatif",
  "cration-de-bombes-graines": "/catalogue/fabrication-de-bombes-graines",
  "balade-avec-un-ane": "/catalogue/temps-avec-le-troupeau-d-anes",
};

const legacy = experience.legacyId ? await getEntry("catalogue", experience.legacyId) : undefined;
const rendered = legacy ? await render(legacy) : undefined;
const Content = rendered?.Content;
const props: Record<string, string> = legacy?.data.properties ?? {};

const participants =
  experience.minParticipants && experience.maxParticipants
    ? `de ${experience.minParticipants} à ${experience.maxParticipants} personnes`
    : experience.maxParticipants
      ? `jusqu'à ${experience.maxParticipants} personnes`
      : experience.minParticipants
        ? `à partir de ${experience.minParticipants} personnes`
        : undefined;

const facts = [
  { label: "Durée", value: experience.duration ?? props["Durée"] },
  { label: "Participants", value: participants },
  { label: "Tarif", value: experience.priceText ?? props["Tarif"] },
  { label: "Pour qui", value: props["Public(s)-cible(s)"] },
  { label: "Type", value: props["Type"] },
];

const description =
  experience.source === "claudy"
    ? seoDescription(
        experience.description || `${experience.title} — une activité proposée aux 4 Sources, à Yvoir.`,
      )
    : experience.description || `${experience.title} — une activité proposée aux 4 Sources, à Yvoir.`;

// L'image publiée dans Claudy l'emporte, rapatriée au build ; sinon la couverture migrée.
const remoteHero =
  experience.source === "claudy"
    ? await claudyImage(experience.image?.url, [640, 960, 1440, 1920], experience.image?.alt)
    : undefined;

// Les autres activités du même pôle : la suite naturelle de la visite.
const { experiences } = await siteData();
const legacyCatalogue = await getCollection("catalogue");
const coverById = new Map(legacyCatalogue.map((e) => [e.id, e.data.cover]));
const related = experiences
  .filter(
    (x) =>
      x.archived !== true &&
      x.path !== experience.path &&
      Boolean(experience.pole) &&
      x.pole === experience.pole,
  )
  .sort((a, b) => a.title.localeCompare(b.title, "fr"))
  .slice(0, 3);
const relatedItems: CardItem[] = await Promise.all(
  related.map(async (x) => ({
    title: x.title,
    href: x.path,
    description: displayDescription(x.description, x.generatedDescription),
    eyebrow: x.duration,
    icon: x.icon,
    pole: x.pole,
    image: (await activityByPath(x.path))?.cover ?? (x.legacyId ? coverById.get(x.legacyId) : undefined),
  })),
);

const siteUrl = (Astro.site ?? new URL(site.url)).href.replace(/\/$/, "");
const url = `${siteUrl}${experience.path}`;
const jsonld = [
  breadcrumbs([
    { name: "Accueil", url: `${siteUrl}/` },
    { name: "Le catalogue", url: `${siteUrl}/catalogue` },
    { name: experience.title, url },
  ]),
];
---

<BaseLayout
  title={experience.seoTitle ?? experience.title}
  description={description}
  noindex={experience.archived === true}
  canonicalPath={experience.archived === true ? SUCCESSORS[experience.slug] : undefined}
  jsonld={jsonld}
>
  <PageHero
    title={experience.title}
    lead={displayDescription(experience.description, experience.generatedDescription)}
    cover={remoteHero ? undefined : legacy?.data.cover}
    coverAlt={legacy?.data.coverAlt ?? experience.title}
    remoteCover={remoteHero}
    pole={isPole(experience.pole) ? experience.pole : undefined}
    crumbs={[
      { label: "Accueil", href: "/" },
      { label: "Le catalogue", href: "/catalogue" },
      { label: experience.title },
    ]}
  />

  <Section class="pt-10">
    <Facts items={facts} />

    {
      /* Un appel à l'action au-dessus du texte dans tous les cas : la réservation
         en ligne quand Claudy la propose, sinon l'e-mail du lieu (celui que le
         texte des fiches donne déjà), avec l'activité en objet. */
      experience.bookingUrl ? (
        <p class="mt-7">
          <Button href={experience.bookingUrl} rel="noopener" size="lg">
            Réserver cette activité
          </Button>
        </p>
      ) : (
        <p class="mt-7">
          <Button
            href={`mailto:${site.email}?subject=${encodeURIComponent(experience.title)}`}
            variant="secondary"
            size="lg"
          >
            Nous écrire pour réserver
          </Button>
        </p>
      )
    }

    {/* Le texte venu de Claudy est brut (sans paragraphes) : colonne de lecture. */}
    <Prose class="mt-9" width={experience.descriptionHtml ? "prose" : "full"}>
      {
        experience.descriptionHtml ? (
          <Fragment set:html={experience.descriptionHtml} />
        ) : Content ? (
          <Content />
        ) : null
      }
    </Prose>
  </Section>

  {
    related.length > 0 && (
      <Section title="D'autres activités du même pôle 🎒" surface="subtle">
        <CardGrid items={relatedItems} poleHeader />
      </Section>
    )
  }
</BaseLayout>
