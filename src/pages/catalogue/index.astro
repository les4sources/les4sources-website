---
import { displayDescription } from "@lib/text";
import { getCollection, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import CardGrid, { type CardItem } from "@components/ui/CardGrid.astro";
import PageHero from "@components/ui/PageHero.astro";
import Prose from "@components/ui/Prose.astro";
import Section from "@components/ds/Section.astro";
import Tag from "@components/ds/Tag.astro";
import { catalogueItems, listedExperiences } from "@lib/catalogue";
import { byPath, visible } from "@lib/content";
import { POLES, isPole, type PoleSlug } from "@lib/poles";
import { PUBLICS, type PublicSlug } from "@lib/publics";

// La page éditoriale /catalogue, si la migration en fournit une, coiffe le listing.
const pages = visible(await getCollection("pages"));
const entry = byPath(pages, "/catalogue");
// Un corps migré vide ne produit pas de section vide (un blanc de 100 px sous le titre).
const rendered = entry?.body?.trim() ? await render(entry) : undefined;
const Content = rendered?.Content;

const listed = await listedExperiences();
const items: CardItem[] = await catalogueItems();

// Filtres : uniquement les pôles réellement représentés dans le catalogue.
const present: PoleSlug[] = Object.values(POLES)
  .map((p) => p.slug)
  .filter((slug) => listed.some((x) => isPole(x.pole) && x.pole === slug));

// Filtre « Pour qui ? » : uniquement les publics qui ont au moins une activité.
const presentPublics: PublicSlug[] = Object.values(PUBLICS)
  .map((p) => p.slug)
  .filter((slug) => listed.some((x) => x.publics.includes(slug)));

const title = entry?.data.title ?? "Le catalogue d'activités";
const description =
  entry?.data.description ??
  "Toutes les activités proposées aux 4 Sources, à Yvoir : nature, artisanat, cuisine, intelligence collective et vie du lieu.";
---

<BaseLayout
  title={entry?.data.seoTitle ?? title}
  description={description}
  ogImage={entry?.data.cover ?? entry?.data.ogImage}
  noindex={entry?.data.noindex ?? false}
>
  <PageHero
    title={title}
    lead={displayDescription(entry?.data.description, entry?.data.generatedDescription)}
    cover={entry?.data.cover}
    coverAlt={entry?.data.coverAlt}
    crumbs={[{ label: "Accueil", href: "/" }, { label: "Le catalogue" }]}
  />

  {
    Content && (
      <Section class="pt-10 pb-0">
        <Prose>
          <Content />
        </Prose>
      </Section>
    )
  }

  <Section title="Les activités 🎒" id="activites">
    {
      presentPublics.length > 0 && (
        <div class="mb-4 flex flex-wrap items-center gap-2" data-filter-group="publics">
          <span class="mr-1 font-ui text-ui text-ink-2">Pour qui ?</span>
          <Tag selected data-filter="all">
            Tout le monde
          </Tag>
          {presentPublics.map((slug) => (
            <Tag data-filter={slug}>{PUBLICS[slug].label}</Tag>
          ))}
        </div>
      )
    }
    {
      present.length > 0 && (
        <div class="mb-8 flex flex-wrap items-center gap-2" data-filter-group="pole">
          <span class="mr-1 font-ui text-ui text-ink-2">Thème</span>
          <Tag selected data-filter="all">
            Toutes
          </Tag>
          {present.map((slug) => (
            <Tag data-filter={slug}>{POLES[slug].category}</Tag>
          ))}
        </div>
      )
    }

    <CardGrid items={items} poleHeader empty="Le catalogue d'activités arrive bientôt." />
  </Section>
</BaseLayout>

<script>
  // Deux filtres cumulables, « Pour qui ? » et thème (pôle) : tout est rendu
  // au build, le script ne fait que masquer. Sans JavaScript, la liste
  // complète reste affichée et lisible. `?pour=familles` (lien depuis une
  // page par public) présélectionne le public.
  const groups = Array.from(document.querySelectorAll<HTMLElement>("[data-filter-group]"));
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-card]"));
  const state: Record<string, string> = { pole: "all", publics: "all" };

  const matches = (card: HTMLElement): boolean =>
    (state.pole === "all" || card.dataset.pole === state.pole) &&
    (state.publics === "all" || (card.dataset.publics ?? "").split(" ").includes(state.publics));

  const render = () => {
    for (const group of groups) {
      const value = state[group.dataset.filterGroup ?? ""] ?? "all";
      for (const tag of group.querySelectorAll<HTMLElement>("[data-filter]")) {
        tag.setAttribute("aria-pressed", tag.dataset.filter === value ? "true" : "false");
      }
    }
    for (const card of cards) card.hidden = !matches(card);
  };

  for (const group of groups) {
    const key = group.dataset.filterGroup ?? "";
    for (const tag of group.querySelectorAll<HTMLElement>("[data-filter]")) {
      tag.addEventListener("click", () => {
        state[key] = tag.dataset.filter ?? "all";
        if (key === "publics") {
          const url = new URL(location.href);
          if (state.publics === "all") url.searchParams.delete("pour");
          else url.searchParams.set("pour", state.publics);
          history.replaceState(null, "", url);
        }
        render();
      });
    }
  }

  const asked = new URLSearchParams(location.search).get("pour");
  const publicsGroup = groups.find((g) => g.dataset.filterGroup === "publics");
  if (asked && publicsGroup?.querySelector(`[data-filter="${CSS.escape(asked)}"]`)) {
    state.publics = asked;
    render();
  }
</script>
