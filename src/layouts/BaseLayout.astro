---
import "@styles/global.css";
import type { ImageMetadata } from "astro";
import SEO from "@components/seo/SEO.astro";
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";
import NewsletterBand from "@components/ds/NewsletterBand.astro";
import { documentTitle as buildDocumentTitle, organization, tidyTitle } from "@lib/seo";
import { site } from "@lib/site";

interface Props {
  /** Titre de la page (`seoTitle ?? title` du contenu) — nettoyé et situé par `documentTitle()`. */
  title: string;
  /** `<title>` déjà composé par la page (fiche événement, qui y ajoute sa date). */
  documentTitle?: string;
  description: string;
  ogImage?: string | ImageMetadata;
  type?: "website" | "article";
  noindex?: boolean;
  /** Schémas JSON-LD propres à la page (Event, BreadcrumbList, FAQPage…). */
  jsonld?: object[];
}

const {
  title,
  documentTitle,
  description,
  ogImage,
  type = "website",
  noindex = false,
  jsonld = [],
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
// <title> : sans emoji, suffixe de section ou de marque s'il tient en 60 caractères.
// og:title : le titre nettoyé seul — les réseaux affichent déjà le nom du site.
const docTitle = documentTitle ?? buildDocumentTitle(title, pathname);
const ogTitle = tidyTitle(title);

const siteUrl = (Astro.site ?? new URL(site.url)).href.replace(/\/$/, "");
// Organization + LodgingBusiness : émis sur toutes les pages (NAP cohérent, GEO).
const allJsonld = [organization({ siteUrl }), ...jsonld];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#224246" />
    <SEO
      title={docTitle}
      ogTitle={ogTitle}
      description={description}
      ogImage={ogImage}
      type={type}
      noindex={noindex}
      jsonld={allJsonld}
    />
  </head>
  <body class="bg-white font-body text-ink">
    {/* z-[60] : l'en-tête collant est en z-50, le lien d'évitement doit passer devant. */}
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-teal focus:px-4 focus:py-2 focus:text-cream"
      >Aller au contenu</a
    >
    <Header />
    <main id="main">
      <slot />
    </main>
    {/* La page /newsletter est le formulaire : pas de bande en double. */}
    {pathname !== "/newsletter" && <NewsletterBand />}
    <Footer />
    {
      /* Le site est statique : une page construite il y a trois jours croit
         encore qu'un événement d'hier est « à venir ». Ce garde-fou, sans
         dépendance, retire ce qui a expiré (`data-until`), révèle ce qui ne
         vaut qu'après (`data-from`) et masque une liste vidée. Le rebuild
         quotidien remet ensuite tout d'aplomb côté serveur. */
    }
    <script is:inline>
      (function () {
        var now = Date.now();
        document.querySelectorAll("[data-until]").forEach(function (el) {
          var t = Date.parse(el.getAttribute("data-until") || "");
          if (t && t <= now) {
            var list = el.parentElement;
            el.remove();
            if (list && list.hasAttribute("data-expiring") && !list.querySelector("[data-until]")) {
              list.hidden = true;
            }
          }
        });
        document.querySelectorAll("[data-from]").forEach(function (el) {
          var t = Date.parse(el.getAttribute("data-from") || "");
          if (t && t <= now) el.hidden = false;
        });
        // Façade vidéo (rehype-youtube) : l'iframe YouTube n'existe qu'au clic.
        document.addEventListener("click", function (e) {
          var link = e.target instanceof Element && e.target.closest("a[data-yt]");
          // Cmd/Ctrl/Maj-clic, clic milieu : le lien ouvre YouTube comme tout lien.
          if (!link || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          e.preventDefault();
          var frame = document.createElement("iframe");
          frame.src = link.getAttribute("data-yt");
          frame.title = link.getAttribute("data-yt-title") || "Vidéo";
          frame.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
          frame.allowFullscreen = true;
          frame.className = "yt-frame";
          link.replaceWith(frame);
          frame.focus();
        });
      })();
    </script>
  </body>
</html>
