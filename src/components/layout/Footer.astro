---
/**
 * Pied de page — inspiré de semisto.org, dans la charte des 4 Sources.
 *
 * Aplat teal (la seule surface sombre de la charte). Colonne de marque : la
 * marque en blanc (vectorielle, le mot lisible à côté, comme dans l'en-tête), la devise, le bandeau des sept pictos de pôle, le bloc NAP
 * complet (adresse de `site.ts` — la même que le JSON-LD —, e-mail, et le
 * seul téléphone publié, celui des réservations) et les réseaux sociaux.
 * Puis les quatre groupes de `nav.ts` sous des surtitres jaunes. Barre du
 * bas : licence, conditions, crédit.
 *
 * Règle stricte héritée de src/lib/site.ts : une donnée inconnue n'est pas
 * affichée. Rien n'est inventé ici — ni rue, ni e-mail, ni réseau social.
 */
import Logo from "@components/ds/Logo.astro";
import PoleIcon from "@components/ds/PoleIcon.astro";
import { footerGroups, socials } from "@lib/nav";
import { POLES, POLE_STRIP } from "@lib/poles";
import { site } from "@lib/site";

const groups = footerGroups();
const socialLinks = socials();
const { streetAddress, postalCode, locality } = site.address;
const year = new Date().getFullYear();

// Le href reste en E.164, l'affichage garde les espaces.
const telHref = `tel:${site.phone.replace(/\s+/g, "")}`;

/** Pictogrammes des réseaux connus ; un réseau sans picto garde son nom. */
const SOCIAL_ICON: Record<string, string> = {
  Facebook:
    "M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4V10.5H8v3h2.4V21h3.1Z",
};
---

<footer class="l4s-footer">
  <div class="l4s-footer-inner">
    <div class="l4s-footer-grid">
      <div class="l4s-footer-brand">
        <Logo href="/" variant="white" size="lg" class="l4s-footer-logo" />
        <p class="l4s-footer-tagline">Lieu d’activités, de nature et de vie collective.</p>

        {/* Les sept pôles. Au survol, le picto s'allume dans la couleur de son
            pôle, son nom apparaît au-dessus, ses deux voisins prennent leur
            propre couleur en écho (`.l4s-pole` dans global.css). */}
        <ul class="l4s-poles mt-5 -ml-2 flex list-none flex-wrap items-center gap-0.5 p-0 min-[1000px]:flex-nowrap">
          {
            POLE_STRIP.map((slug) => {
              const p = POLES[slug];
              const onPole = p.lightOnSolid ? "var(--color-teal)" : "var(--color-white)";
              return (
                <li class="l4s-pole" style={`--pole:var(${p.vars.color});--on-pole:${onPole}`} title={p.category}>
                  <span class="l4s-pole-name" aria-hidden="true">
                    {p.category}
                  </span>
                  <PoleIcon pole={slug} class="h-7" />
                  <span class="sr-only">{p.category}</span>
                </li>
              );
            })
          }
        </ul>

        <address class="l4s-footer-nap">
          <span>{streetAddress}</span>
          <span>{postalCode} {locality}, Belgique</span>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <span class="l4s-footer-phone">
            <a href={telHref}>{site.phone}</a>
            <span class="l4s-footer-badge">réservations</span>
          </span>
        </address>

        {
          socialLinks.length > 0 && (
            <ul class="l4s-footer-socials">
              {socialLinks.map((s) => (
                <li>
                  <a href={s.url} rel="noopener" aria-label={s.label} title={s.label}>
                    {SOCIAL_ICON[s.label] ? (
                      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d={SOCIAL_ICON[s.label]} />
                      </svg>
                    ) : (
                      s.label
                    )}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        groups.map((group) => (
          <nav aria-label={group.title} class="l4s-footer-group">
            <p class="l4s-footer-overline">{group.title}</p>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a href={link.path} rel={link.external ? "noopener" : undefined}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="l4s-footer-bottom">
      <p>
        © {year} {site.name} · Site et photos sous <a href={site.licence.url} rel="noopener"
          >licence Creative Commons BY-NC-SA 4.0</a
        >.
      </p>
      <ul>
        <li><a href="/sejours/conditions">Conditions générales</a></li>
        <li><a href="/sejours/regles-du-lieu">Règles du lieu</a></li>
      </ul>
      <p class="l4s-footer-credit">
        Site web propulsé par <a href="https://supergenial.be" rel="noopener">Super Génial</a>
      </p>
    </div>
  </div>
</footer>
