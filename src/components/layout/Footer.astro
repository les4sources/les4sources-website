---
/**
 * Pied de page — portage de `design/ui_kits/Footer.jsx`.
 *
 * Aplat teal (la seule surface sombre de la charte), texte et pictogrammes en
 * blanc. Colonne 1 : le logo blanc, le bandeau des 7 pictogrammes de pôle et le
 * bloc NAP complet — l'adresse postale de `site.ts` (la même que le JSON-LD),
 * l'e-mail, et le seul téléphone publié sur le site, la ligne réservations,
 * avec son étiquette. Colonnes 2 à 5 : les groupes de `nav.ts`. Barre du bas :
 * la phrase de licence de l'ancien site (« licence », avec le lien vers la
 * licence) et les réseaux sociaux.
 *
 * Règle stricte héritée de src/lib/site.ts : une donnée inconnue n'est pas
 * affichée. Rien n'est inventé ici — ni rue, ni e-mail, ni réseau social.
 */
import { Image } from "astro:assets";
import logoWhite from "@assets/brand/logo/logo-white.png";
import PoleIcon from "@components/ds/PoleIcon.astro";
import { footerGroups, socials } from "@lib/nav";
import { POLES, POLE_STRIP } from "@lib/poles";
import { site } from "@lib/site";

const groups = footerGroups();
const socialLinks = socials();
const { streetAddress, postalCode, locality } = site.address;

// Le href reste en E.164, l'affichage garde les espaces.
const telHref = `tel:${site.phone.replace(/\s+/g, "")}`;
---

<footer class="bg-teal text-white">
  <div class="mx-auto max-w-site px-6 pt-14 pb-8">
    <div
      class="grid grid-cols-1 gap-8 min-[640px]:grid-cols-2 min-[1000px]:grid-cols-[1.2fr_repeat(4,1fr)]"
    >
      <div>
        <Image
          src={logoWhite}
          alt={site.name}
          height={120}
          width={120}
          class="-ml-3 h-[120px] w-auto"
          loading="lazy"
        />

        {/* Les sept pôles. Au survol, le picto s'allume dans la couleur de son
            pôle (disque plein, picto en teal ou en blanc selon `lightOnSolid`),
            son nom apparaît au-dessus, et ses deux voisins prennent leur propre
            couleur en écho. Le CSS vit dans global.css (`.l4s-pole`). */}
        <ul class="l4s-poles mt-2 -ml-2 flex list-none flex-wrap items-center gap-0.5 p-0">
          {
            POLE_STRIP.map((slug) => {
              const p = POLES[slug];
              const onPole = p.lightOnSolid ? "var(--color-teal)" : "var(--color-white)";
              return (
                <li
                  class="l4s-pole"
                  style={`--pole:var(${p.vars.color});--on-pole:${onPole}`}
                  title={p.category}
                >
                  <span class="l4s-pole-name" aria-hidden="true">
                    {p.category}
                  </span>
                  <PoleIcon pole={slug} class="h-7" />
                  <span class="sr-only">{p.category}</span>
                </li>
              );
            })
          }
        </ul>

        <address class="mt-4 font-ui text-[13px] leading-relaxed text-white/90 not-italic">
          <span class="block">{streetAddress}</span>
          <span class="block">{postalCode} {locality}, Belgique</span>
          <a href={`mailto:${site.email}`} class="block text-white no-underline hover:underline">
            {site.email}
          </a>
          <span class="mt-1 flex flex-wrap items-center gap-2">
            <a href={telHref} class="text-white no-underline hover:underline">{site.phone}</a>
            <span class="rounded-xs bg-hebergement px-1.5 py-0.5 font-ui text-[11px] font-bold text-white">
              réservations
            </span>
          </span>
        </address>
      </div>

      {
        groups.map((group) => (
          <nav aria-label={group.title}>
            <p class="mb-3.5 font-ui text-overline font-bold tracking-[0.08em] uppercase text-white/70">
              {group.title}
            </p>
            <ul class="grid list-none gap-2 p-0">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.path}
                    class="font-ui text-ui font-normal text-white no-underline hover:underline"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div
      class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t border-white/20 pt-5 font-ui text-caption text-white/75"
    >
      <p class="max-w-[62ch]">
        Ce site web et nos photos sont sous <a
          href={site.licence.url}
          rel="noopener"
          class="text-white/75 underline hover:text-white">licence {site.licence.name}</a
        >.
      </p>
      {
        socialLinks.length > 0 && (
          <ul class="flex list-none flex-wrap gap-4 p-0">
            {socialLinks.map((s) => (
              <li>
                <a href={s.url} rel="noopener" class="text-white/75 no-underline hover:text-white">
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</footer>
