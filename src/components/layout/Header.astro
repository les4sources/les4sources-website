---
/**
 * En-tête du site — inspiré de semisto.org, dans la charte des 4 Sources.
 *
 * En haut de page, la navigation flotte dans une pilule blanche ombrée ; dès
 * qu'on défile, la pilule se fond dans une barre blanche pleine largeur. La
 * hauteur (72 px) et la position de chaque élément ne bougent pas d'un pixel
 * entre les deux états : seuls le fond, l'ombre et le filet changent.
 *
 * Pilule : ☰ (ouvre le menu complet, src/components/layout/MenuDrawer.astro),
 * la marque, puis les six liens du site historique (dès 1 080 px), le lien
 * courant souligné de teal, le survol souligné de jaune. À droite : l'espace
 * client (dès 1 280 px) et le bouton jaune « Réserver » — la demande de
 * réservation dans Claudy (décision du 2026-09-08).
 */
import { HEADER_CTA, primaryNav } from "@lib/nav";
import { site } from "@lib/site";
import Button from "@components/ds/Button.astro";
import Logo from "@components/ds/Logo.astro";

const nav = primaryNav();

const current = Astro.url.pathname.replace(/\/+$/, "") || "/";
// Un seul lien courant : le plus spécifique qui corresponde
// (/sejours/salles → « Salles », pas « Séjours »).
const activePath = nav
  .filter((l) => current === l.path || current.startsWith(`${l.path}/`))
  .sort((a, b) => b.path.length - a.path.length)[0]?.path;
---

<header class="l4s-site-header" data-l4s-header data-at-top>
  <div class="l4s-header-inner">
    <div class="l4s-header-pill">
      <button
        type="button"
        class="l4s-burger"
        data-l4s-menu-toggle
        aria-expanded="false"
        aria-controls="l4s-menu"
        aria-label="Ouvrir le menu"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M3.5 6.5h17M3.5 12h17M3.5 17.5h11" />
        </svg>
      </button>

      <Logo href="/" size="md" variant="teal" class="l4s-header-logo" />

      <nav aria-label="Navigation principale" class="l4s-header-nav">
        {
          nav.map((link) => (
            <a href={link.path} class="l4s-navlink" aria-current={link.path === activePath ? "page" : undefined}>
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="l4s-header-actions">
      <a href={site.portalUrl} rel="noopener" class="l4s-header-portal">Espace client</a>
      <Button variant="highlight" size="md" href={HEADER_CTA.href} class="l4s-header-cta">
        {HEADER_CTA.label}
      </Button>
    </div>
  </div>
</header>

<script>
  // Pilule flottante en haut de page, barre pleine dès qu'on défile. Une
  // sentinelle d'1 px en haut du document dit si l'on est « en haut » : pas
  // d'écouteur de défilement, aucun travail tant que l'état ne change pas.
  const header = document.querySelector<HTMLElement>("[data-l4s-header]");
  if (header) {
    const sentinel = document.createElement("div");
    sentinel.setAttribute("aria-hidden", "true");
    sentinel.style.cssText = "position:absolute;top:0;left:0;width:1px;height:8px;pointer-events:none";
    document.body.prepend(sentinel);
    new IntersectionObserver(([entry]) => {
      header.toggleAttribute("data-at-top", entry?.isIntersecting ?? true);
    }).observe(sentinel);
  }
</script>
