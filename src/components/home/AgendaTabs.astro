---
/**
 * Onglets « À venir / Passés » de l'agenda — même dessin que `ds/Tabs.astro`
 * (soulignement jaune, motif ARIA à activation manuelle), mais avec deux slots
 * statiques : le composant du DS déclare ses panneaux par un nom de slot
 * calculé, ce que le compilateur Astro refuse.
 *
 * L'onglet actif vit dans l'URL : `#a-venir` / `#passes` (les identifiants
 * des panneaux). Un lien partagé vers `/agenda#passes` s'ouvre sur les
 * événements passés ; changer d'onglet met l'adresse à jour sans faire
 * défiler la page ni empiler l'historique.
 *
 * Sans JavaScript, les onglets sont des ancres et les deux panneaux restent
 * affichés : la page entière est lisible.
 */
interface Props {
  upcomingLabel: string;
  pastLabel: string;
  id?: string;
  /** Ancre du panneau « à venir » (et hash de l'URL quand il est actif). */
  upcomingHash?: string;
  /** Ancre du panneau « passés ». */
  pastHash?: string;
}

const { upcomingLabel, pastLabel, id = "agenda", upcomingHash = "a-venir", pastHash = "passes" } =
  Astro.props;

const TAB =
  "-mb-[1.5px] shrink-0 border-b-[3px] px-3.5 py-2.5 font-ui text-ui no-underline transition-colors duration-[120ms]";
const ON = "border-highlight font-bold text-teal";
const OFF = "border-transparent text-ink-2 hover:text-teal";
---

<div class="l4s-tabs" data-l4s-agenda-tabs>
  <div role="tablist" class="flex gap-1 overflow-x-auto border-b-[1.5px] border-line">
    <a
      role="tab"
      id={`${id}-tab-upcoming`}
      href={`#${upcomingHash}`}
      aria-controls={upcomingHash}
      aria-selected="true"
      tabindex="0"
      class:list={[TAB, ON]}>{upcomingLabel}</a
    >
    <a
      role="tab"
      id={`${id}-tab-past`}
      href={`#${pastHash}`}
      aria-controls={pastHash}
      aria-selected="false"
      tabindex="-1"
      class:list={[TAB, OFF]}>{pastLabel}</a
    >
  </div>

  <div
    role="tabpanel"
    id={upcomingHash}
    aria-labelledby={`${id}-tab-upcoming`}
    tabindex="0"
    data-active
    class="l4s-tabpanel pt-6 focus-visible:outline-none"
  >
    <slot name="upcoming" />
  </div>

  <div
    role="tabpanel"
    id={pastHash}
    aria-labelledby={`${id}-tab-past`}
    tabindex="0"
    class="l4s-tabpanel pt-6 focus-visible:outline-none"
  >
    <slot name="past" />
  </div>
</div>

<style>
  .l4s-tabs[data-ready] [role="tabpanel"]:not([data-active]) {
    display: none;
  }
  /* Arrivée sur /agenda#passes : la page s'arrête au panneau en gardant sous
     l'en-tête collant (72 px) la rangée d'onglets qui le nomme. */
  .l4s-tabpanel {
    scroll-margin-top: 136px;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-l4s-agenda-tabs]").forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLAnchorElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    if (tabs.length === 0) return;

    const select = (index: number, focus = true) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute("aria-selected", on ? "true" : "false");
        tab.tabIndex = on ? 0 : -1;
        tab.classList.toggle("border-highlight", on);
        tab.classList.toggle("font-bold", on);
        tab.classList.toggle("text-teal", on);
        tab.classList.toggle("border-transparent", !on);
        tab.classList.toggle("text-ink-2", !on);
      });
      panels.forEach((panel, i) => panel.toggleAttribute("data-active", i === index));
      if (focus) tabs[index]?.focus();
    };

    // L'onglet dont le panneau porte le hash de l'URL, sinon aucun.
    const fromHash = (): number => {
      const hash = decodeURIComponent(window.location.hash.slice(1));
      return hash ? panels.findIndex((panel) => panel.id === hash) : -1;
    };

    // Changer d'onglet écrit son hash dans l'adresse, sans défilement ni
    // entrée d'historique supplémentaire.
    const remember = (index: number) => {
      const panelId = panels[index]?.id;
      if (!panelId) return;
      history.replaceState(history.state, "", `#${panelId}`);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", (event) => {
        event.preventDefault();
        select(index, false);
        remember(index);
      });
      tab.addEventListener("keydown", (event) => {
        const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
        if (step === 0) return;
        event.preventDefault();
        const next = (index + step + tabs.length) % tabs.length;
        select(next);
        remember(next);
      });
    });

    // Arrivée sur /agenda#passes, ou hash changé à la main : l'onglet suit.
    const initial = fromHash();
    if (initial >= 0) select(initial, false);
    window.addEventListener("hashchange", () => {
      const index = fromHash();
      if (index >= 0) select(index, false);
    });

    root.setAttribute("data-ready", "");
  });
</script>
