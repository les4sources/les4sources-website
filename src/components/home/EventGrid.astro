---
/**
 * Grille d'EventCard — 3 colonnes (agenda, événements) ou 4 (accueil).
 * Chaque case porte ses thématiques : c'est ce que filtre la barre de Tags.
 * Chaque case est un conteneur flex : la carte la remplit, toutes les cartes
 * d'une rangée ont la même hauteur.
 *
 * `snap` : sous 640 px, une rangée défilante avec accroche (`.l4s-snap-row`,
 * global.css) plutôt qu'une pile de cartes pleine largeur — c'est le choix de
 * l'accueil, pas des listes longues de l'agenda.
 *
 * En quatre colonnes (l'accueil), la grille ne montre que des rangées pleines
 * — 4 ou 8 cartes, jamais une carte seule sur sa rangée : le bouton vers
 * l'agenda mène au reste.
 */
import EventCard from "@components/ds/EventCard.astro";
import type { EventItem } from "./events";

interface Props {
  items: EventItem[];
  /** Nombre de colonnes sur grand écran. */
  cols?: 3 | 4;
  /** Cartes sans photo — les listes longues (événements passés) restent légères. */
  withImages?: boolean;
  /** Rangée défilante sous 640 px au lieu d'une pile. */
  snap?: boolean;
  /**
   * Liste « à venir » : chaque carte porte sa date d'expiration et le
   * navigateur la retire une fois l'événement passé, même si le dernier build
   * date de plusieurs jours (`data-until`, BaseLayout).
   */
  expire?: boolean;
  /** Nombre de premières cartes dont la photo se charge d'emblée (visibles à l'arrivée). */
  eager?: number;
  /** Niveau des titres de carte : 3 sous un h2, 4 sous un intertitre h3 (année). */
  headingLevel?: 3 | 4;
  class?: string;
}

const {
  items,
  cols = 3,
  withImages = true,
  snap = false,
  expire = false,
  eager = 0,
  headingLevel = 3,
  class: className,
} = Astro.props;

const COLS: Record<3 | 4, string> = {
  3: "sm:grid-cols-2 lg:grid-cols-3",
  4: "sm:grid-cols-2 lg:grid-cols-4",
};

// Quatre colonnes : des rangées pleines seulement (4, 8…), à partir de 4 cartes.
const shown = cols === 4 && items.length > 4 ? items.slice(0, Math.floor(items.length / 4) * 4) : items;
---

<ul
  data-expiring={expire ? "" : undefined}
  class:list={[
    "m-0 list-none p-0",
    snap ? "l4s-snap-row sm:grid sm:gap-5" : "grid grid-cols-1 gap-5",
    COLS[cols],
    className,
  ]}
>
  {
    shown.map((e, i) => (
      <li
        class="flex min-w-0"
        data-event
        data-categories={e.categories.join("|")}
        data-until={expire ? e.until : undefined}
      >
        <EventCard
          title={e.title}
          date={e.dateLabel ?? ""}
          pole={e.pole}
          soldOut={e.soldOut}
          href={e.path}
          image={withImages ? e.cover : undefined}
          imageLoading={i < eager ? "eager" : "lazy"}
          headingLevel={headingLevel}
        />
      </li>
    ))
  }
</ul>
