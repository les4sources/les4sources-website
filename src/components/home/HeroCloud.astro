---
/**
 * Hero de l'accueil — la photo drone en pleine largeur et, posé dessus, le
 * « nuage » blanc de la charte (motif signature n°1 : une bulle aux bords
 * organiques, jamais un flou ni un dégradé).
 *
 * Le nuage rétrécit avec l'écran : pas de largeur minimale en pixels, un
 * rembourrage en `clamp()` — à 375 px il tient dans la page sans la déborder.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Logo from "@components/ds/Logo.astro";

interface Props {
  image: ImageMetadata;
  imageAlt?: string;
  title: string;
  subtitle?: string;
}

const { image, imageAlt = "", title, subtitle } = Astro.props;
---

<section class="relative isolate overflow-hidden" style="height:clamp(400px,58vw,560px)">
  <Image
    src={image}
    alt={imageAlt}
    widths={[640, 960, 1440, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 h-full w-full object-cover"
  />

  <div class="absolute inset-0 grid place-items-center px-4">
    <div
      class="bg-white text-center"
      style="border-radius:48% 52% 50% 50% / 55% 55% 45% 45%; width:min(92vw,620px); padding:clamp(28px,5vw,56px) clamp(28px,8vw,96px)"
    >
      <Logo markOnly size={56} class="mb-2.5" />
      <h1
        class="font-display font-bold uppercase leading-[1.08] tracking-[0.02em]"
        style="font-size:clamp(28px,6.4vw,56px)"
      >
        {title}
      </h1>
      {subtitle && <p class="mt-2 font-display text-h3 text-ink-2">{subtitle}</p>}
    </div>
  </div>
</section>
