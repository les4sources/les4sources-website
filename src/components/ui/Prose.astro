---
/**
 * Habille le Markdown des collections (et le HTML public venu de Claudy) avec
 * la typographie du brand system : Averia pour tout le texte courant, Be Vietnam
 * Pro pour ce qui est fonctionnel (grilles tarifaires, légendes, boutons).
 *
 * `width="prose"` (défaut) tient la ligne à ~68 caractères ; `width="full"`
 * laisse le conteneur décider — ce qu'il faut aux pages à colonnes ou à tableaux.
 */
interface Props {
  width?: "prose" | "full";
  class?: string;
}

const { width = "prose", class: className } = Astro.props;
---

<div class:list={["prose-4s", width === "prose" ? "max-w-[68ch]" : "w-full is-wide", className]}>
  <slot />
</div>

<style>
  .prose-4s {
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: 1.55;
    color: var(--color-ink);
  }

  /* Pleine largeur : les colonnes, tableaux, galeries et embeds prennent toute
     la place, mais le texte courant garde une ligne lisible (~68 caractères).
     Une phrase de 1 180 px de long, c'est ce qui rendait les pages à colonnes
     pénibles à lire. */
  .prose-4s.is-wide > :global(p),
  .prose-4s.is-wide > :global(ul),
  .prose-4s.is-wide > :global(ol),
  .prose-4s.is-wide > :global(h2),
  .prose-4s.is-wide > :global(h3),
  .prose-4s.is-wide > :global(h4),
  .prose-4s.is-wide > :global(blockquote),
  .prose-4s.is-wide > :global(details) {
    max-width: 68ch;
  }

  /* ── Titres ─────────────────────────────────────────────────────────── */
  .prose-4s :global(h2) {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    line-height: 1.15;
    letter-spacing: -0.01em;
    font-weight: 700;
    color: var(--color-ink);
    margin: 2.6rem 0 1rem;
    text-wrap: balance;
  }
  .prose-4s :global(h3) {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: 1.15;
    font-weight: 700;
    color: var(--color-ink);
    margin: 2.1rem 0 0.75rem;
    text-wrap: balance;
  }
  .prose-4s :global(h4),
  .prose-4s :global(h5),
  .prose-4s :global(h6) {
    font-family: var(--font-display);
    font-size: var(--text-h4);
    line-height: 1.3;
    font-weight: 700;
    color: var(--color-ink);
    margin: 1.7rem 0 0.6rem;
    text-wrap: balance;
  }
  .prose-4s :global(h2:first-child),
  .prose-4s :global(h3:first-child),
  .prose-4s :global(h4:first-child) {
    margin-top: 0;
  }
  @media (max-width: 640px) {
    .prose-4s :global(h2) {
      font-size: 28px;
    }
    .prose-4s :global(h3) {
      font-size: 23px;
    }
    .prose-4s :global(h4) {
      font-size: 20px;
    }
  }

  /* ── Texte courant ──────────────────────────────────────────────────── */
  .prose-4s :global(p) {
    margin: 0 0 1.15em;
    text-wrap: pretty;
  }
  .prose-4s :global(strong) {
    font-weight: 700;
    color: var(--color-ink);
  }
  .prose-4s :global(hr) {
    border: 0;
    border-top: 1.5px solid var(--color-line-soft);
    margin: 2.5rem 0;
  }

  /* Liens : souligné teal, souligné jaune au survol (motif de la charte). */
  .prose-4s :global(a) {
    color: var(--color-teal);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
    transition:
      color 120ms var(--ease-brand),
      text-decoration-color 120ms var(--ease-brand);
  }
  .prose-4s :global(a:hover) {
    color: var(--color-teal-soft);
    text-decoration-color: var(--color-highlight);
    text-decoration-thickness: 3px;
  }

  /* Un intertitre-lien (hubs /a-propos, /sejours/sejours) se lit comme un titre :
     pas de soulignement au repos, le surligné jaune de la charte au survol. */
  .prose-4s :global(:is(h2, h3, h4) a) {
    color: inherit;
    text-decoration-color: transparent;
  }
  .prose-4s :global(:is(h2, h3, h4) a:hover) {
    color: var(--color-teal);
    text-decoration-color: var(--color-highlight);
  }

  /* ── Listes ─────────────────────────────────────────────────────────── */
  .prose-4s :global(ul),
  .prose-4s :global(ol) {
    margin: 0 0 1.3em;
    padding-left: 1.35em;
  }
  /* Tailwind remet les listes a zero : la puce du contenu migre est retablie ici. */
  .prose-4s :global(ul) {
    list-style: disc;
  }
  .prose-4s :global(ol) {
    list-style: decimal;
  }
  .prose-4s :global(ul ul) {
    list-style: circle;
  }
  .prose-4s :global(li) {
    margin: 0 0 0.55em;
    padding-left: 0.15em;
  }
  .prose-4s :global(li::marker) {
    color: var(--color-teal-soft);
  }
  .prose-4s :global(li > ul),
  .prose-4s :global(li > ol) {
    margin-top: 0.55em;
  }

  /* ── Citation → carte papier (le site s'en sert comme d'un encadré) ─── */
  .prose-4s :global(blockquote) {
    background: var(--color-paper);
    border: 1.5px solid var(--color-line-soft);
    border-radius: var(--radius-photo);
    padding: 1.15rem 1.4rem;
    margin: 1.9rem 0;
    color: var(--color-ink);
  }
  .prose-4s :global(blockquote > :last-child) {
    margin-bottom: 0;
  }

  /* ── Lien-bouton `{.button}` = bouton primaire du DS ─────────────────── */
  .prose-4s :global(a.button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: var(--control-h-md);
    padding: 0 20px;
    border: 1.5px solid var(--color-teal);
    border-radius: var(--radius-pill);
    background: var(--color-teal);
    color: var(--color-white);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.01em;
    text-decoration: none;
    margin: 0.35rem 0.5rem 0.35rem 0;
    transition:
      background-color 120ms var(--ease-brand),
      border-color 120ms var(--ease-brand);
  }
  .prose-4s :global(a.button:hover) {
    background: var(--color-teal-soft);
    border-color: var(--color-teal-soft);
    color: var(--color-white);
    text-decoration: none;
  }
  .prose-4s :global(a.button:active) {
    background: var(--color-teal-deep);
    border-color: var(--color-teal-deep);
  }

  /* ── Tableaux (grilles tarifaires) ──────────────────────────────────── */
  .prose-4s :global(table) {
    display: block;
    /* Le cadre épouse les colonnes : une grille de quatre tarifs n'a pas à
       s'étirer sur 1 180 px. Au-delà de la place disponible, elle défile. */
    width: max-content;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 1.9rem 0;
    font-family: var(--font-ui);
    font-size: 15px;
    line-height: 1.4;
    border: 1.5px solid var(--color-line-soft);
    border-radius: var(--radius-md);
  }
  .prose-4s :global(th),
  .prose-4s :global(td) {
    border-bottom: 1px solid var(--color-line-soft);
    border-right: 1px solid var(--color-line-soft);
    padding: 10px 14px;
    text-align: left;
    vertical-align: top;
    color: var(--color-ink);
    min-width: 9ch;
    max-width: 34ch;
  }
  .prose-4s :global(th:last-child),
  .prose-4s :global(td:last-child) {
    border-right: 0;
  }
  .prose-4s :global(tbody tr:last-child td) {
    border-bottom: 0;
  }
  .prose-4s :global(th) {
    background: var(--color-paper);
    font-weight: 700;
    color: var(--color-teal);
  }
  /* La colonne des intitulés reste visible quand la grille défile (mobile). */
  .prose-4s :global(td:first-child),
  .prose-4s :global(th:first-child) {
    position: sticky;
    left: 0;
    z-index: 1;
    min-width: 12ch;
    max-width: 30ch;
    background: var(--color-white);
    box-shadow: inset -1px 0 0 var(--color-line-soft);
  }
  .prose-4s :global(th:first-child) {
    background: var(--color-paper);
  }
  /* Grilles tarifaires : seules les colonnes de montants (marquées par
     src/plugins/rehype-tidy.ts) s'alignent à droite, en chiffres tabulaires ;
     un montant ne se coupe pas, le texte d'une condition, si. */
  .prose-4s :global(.is-num) {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .prose-4s :global(th a) {
    color: inherit;
  }
  .prose-4s :global(tbody tr:hover td) {
    background: var(--color-paper);
  }

  /* ── Images ─────────────────────────────────────────────────────────── */
  .prose-4s :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-photo);
    margin: 1.8rem 0;
  }
  .prose-4s :global(figure) {
    margin: 1.8rem 0;
  }
  .prose-4s :global(figure img) {
    margin: 0;
  }
  .prose-4s :global(figcaption) {
    font-family: var(--font-ui);
    font-size: var(--text-caption);
    color: var(--color-ink-3);
    margin-top: 0.6rem;
  }

  /* ── Embeds (Claudy, Tally, Listmonk, cartes, vidéos) ───────────────── */
  .prose-4s :global(iframe) {
    display: block;
    width: 100%;
    max-width: 100%;
    border: 0;
    border-radius: var(--radius-photo);
    background: var(--color-surface);
    margin: 1.8rem 0;
  }
  .prose-4s :global(iframe.embed) {
    aspect-ratio: 16 / 9;
    min-height: 320px;
  }
  /* Formulaires et calendriers : hauteur utile, pas de rapport d'image. */
  .prose-4s :global(iframe.embed-iframe),
  .prose-4s :global(iframe.embed-tally),
  .prose-4s :global(iframe.embed-listmonk),
  .prose-4s :global(iframe.embed-form) {
    aspect-ratio: auto;
    min-height: 720px;
  }
  /* Tally ajuste lui-même sa hauteur (dynamicHeight) : un plancher bas évite
     375 px de gris sous un formulaire court (/newsletter). */
  .prose-4s :global(iframe.embed-tally) {
    min-height: 280px;
    background: transparent;
  }
  .prose-4s :global(iframe.embed-map) {
    aspect-ratio: 4 / 3;
  }
  /* Façade vidéo (global.css) : la vignette remplit son cadre, sans les marges
     ni les coins des images du texte ; le lien n'est pas souligné. */
  .prose-4s :global(a.yt-facade) {
    text-decoration: none;
  }
  .prose-4s :global(a.yt-facade > img) {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    margin: 0;
    border-radius: 0;
  }

  /* ── Signet et pièce jointe → cartes de lien ────────────────────────── */
  .prose-4s :global(a.bookmark),
  .prose-4s :global(a.file-download) {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    border: 1.5px solid var(--color-line-soft);
    border-radius: var(--radius-photo);
    background: var(--color-white);
    padding: 0.95rem 1.2rem;
    margin: 1.3rem 0;
    color: var(--color-teal);
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition:
      box-shadow 200ms var(--ease-brand),
      border-color 120ms var(--ease-brand);
  }
  .prose-4s :global(a.bookmark:hover),
  .prose-4s :global(a.file-download:hover) {
    box-shadow: var(--shadow-md);
    border-color: var(--color-line);
    text-decoration: none;
  }
  .prose-4s :global(a.bookmark::before) {
    content: "→";
    color: var(--color-ink-3);
  }
  .prose-4s :global(a.file-download::before) {
    content: "↓";
    color: var(--color-ink-3);
  }

  /* ── Blocs dépliants (toggles Notion migrés en <details>) ───────────── */
  .prose-4s :global(details) {
    border: 1.5px solid var(--color-line-soft);
    border-radius: var(--radius-photo);
    background: var(--color-white);
    padding: 0.95rem 1.2rem;
    margin: 0 0 1rem;
  }
  .prose-4s :global(details[open]) {
    background: var(--color-paper);
  }
  .prose-4s :global(summary) {
    cursor: pointer;
    font-weight: 700;
    color: var(--color-teal);
    list-style: none;
  }
  .prose-4s :global(summary::-webkit-details-marker) {
    display: none;
  }
  .prose-4s :global(summary::before) {
    content: "›";
    display: inline-block;
    margin-right: 0.5rem;
    transition: transform 200ms var(--ease-brand);
  }
  .prose-4s :global(details[open] summary::before) {
    transform: rotate(90deg);
  }
  .prose-4s :global(details > :not(summary)) {
    margin-top: 0.9rem;
  }

  /* ── Colonnes (cf. src/plugins/rehype-columns.ts) ───────────────────── */
  .prose-4s :global(.columns) {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    margin: 1.6rem 0;
  }
  .prose-4s :global(.column > :last-child) {
    margin-bottom: 0;
  }
  /* Les photos d'une rangée de colonnes partagent un même cadre (4/3) : deux
     photos côte à côte ne s'arrêtent plus à deux hauteurs différentes. */
  .prose-4s :global(.column img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    margin: 0 0 0.9rem;
  }
  /* Une ligne en italique sous une photo est sa légende : elle s'y colle. */
  .prose-4s :global(.column p:has(> img) + p:has(> em:only-child)) {
    margin-top: -0.3rem;
    font-family: var(--font-ui);
    font-size: var(--text-caption);
    color: var(--color-ink-3);
  }
  .prose-4s :global(.column p:has(> img)) {
    margin-bottom: 0;
  }
  .prose-4s :global(.column p:has(> img) + p:has(> em:only-child) em) {
    font-style: normal;
  }
  @media (min-width: 768px) {
    .prose-4s :global(.columns) {
      flex-direction: row;
      align-items: flex-start;
      gap: 2.5rem;
    }
    .prose-4s :global(.column) {
      /* La largeur déclarée dans le contenu migré devient la flex-basis. */
      flex: 1 1 var(--col-w, 0%);
      min-width: 0;
    }
  }
</style>
