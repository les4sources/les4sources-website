---
/**
 * En-tête de page du brand system : fil d'Ariane en Be Vietnam Pro, étiquette
 * de pôle, H1 Averia Bold (l'emoji fait partie du titre, comme sur le site
 * actuel), chapeau en encre secondaire, et la photo de couverture.
 *
 * Refonte inspirée de semisto.org : dès 1 000 px, une page qui a une vraie
 * photo de couverture ouvre sur une bande papier partagée — le texte à gauche,
 * la photo à droite (4/3, coins de photo, ombre douce), comme le hero de
 * l'accueil. Un bandeau très large (plus de 2,4:1) ou `bleed` garde la photo
 * pleine largeur sous le titre. Sous 1 000 px : titre, puis photo.
 *
 * Un seul `<h1>` par page : c'est ici qu'il vit.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import PoleTag from "@components/ds/PoleTag.astro";
import Photo from "@components/ui/Photo.astro";
import type { RemoteImage } from "@lib/remote-image";
import { isPole } from "@lib/poles";
import Breadcrumbs, { type Crumb } from "./Breadcrumbs.astro";

interface Props {
  title: string;
  /** Sur-titre court (date, durée, section) — en capitales Be Vietnam Pro. */
  eyebrow?: string;
  lead?: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  /** Point focal de la couverture (« 50% 25% »), cf. `coverPosition` du contenu. */
  coverPosition?: string;
  /** Image Claudy rapatriée au build (src/lib/remote-image.ts) — repli quand `cover` est absent. */
  remoteCover?: RemoteImage;
  pole?: string;
  crumbs?: Crumb[];
  /** Colonne éditoriale à 760 px plutôt que la pleine largeur du site. */
  narrow?: boolean;
  /** Photo à fond perdu, sans coins arrondis ni gouttière. */
  bleed?: boolean;
  class?: string;
}

const {
  title,
  eyebrow,
  lead,
  cover,
  coverAlt,
  coverPosition,
  remoteCover,
  pole,
  crumbs = [],
  narrow = false,
  bleed = false,
  class: className,
} = Astro.props;

// Une seule grille : la colonne étroite garde le bord gauche du site (voir Section).
const container = "max-w-site";
const hasCover = Boolean(cover) || Boolean(remoteCover);

// Un vrai bandeau (plus large que 2,4:1) garde son format, pour ne pas être
// agrandi jusqu'au flou : il reste pleine largeur sous le titre.
const source = cover ?? remoteCover;
const banner = source?.width && source?.height ? source.width / source.height > 2.4 : false;
// Hero partagé texte | photo : une vraie photo, ni bandeau ni fond perdu.
const split = hasCover && !banner && !bleed;
const frame = bleed ? "max-h-[62vh]" : "rounded-photo";
---

<header
  class:list={[
    // La bande papier passe sous l'en-tête collant (72 px) : la pilule flotte dessus.
    split
      ? "-mt-[72px] bg-paper px-6 pt-[calc(72px+clamp(18px,3vw,32px))] pb-10 min-[1000px]:pb-16"
      : ["px-6 pt-[clamp(18px,3vw,32px)]", hasCover ? "pb-0" : "pb-2"],
    className,
  ]}
>
  <div
    class:list={[
      "mx-auto w-full",
      container,
      split && "min-[1000px]:grid min-[1000px]:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] min-[1000px]:items-center min-[1000px]:gap-14",
    ]}
  >
    <div class:list={[split && "min-[1000px]:py-6"]}>
    {crumbs.length > 0 && <Breadcrumbs items={crumbs} />}

    {
      ((pole && isPole(pole)) || eyebrow) && (
        <div class:list={["flex flex-wrap items-center gap-3", crumbs.length > 0 ? "mt-5" : ""]}>
          {pole && isPole(pole) && <PoleTag pole={pole} />}
          {eyebrow && (
            <span class="font-ui text-[13px] font-bold tracking-[0.08em] text-ink-3 uppercase">
              {eyebrow}
            </span>
          )}
        </div>
      )
    }

    <h1
      class="mt-4 max-w-[24ch] font-display text-[clamp(30px,6vw,48px)] leading-[1.12] font-bold tracking-[-0.01em]"
    >
      {title}
    </h1>

    {lead && <p data-l4s-lead class="mt-4 max-w-[640px] font-body text-lead text-ink-2">{lead}</p>}
    </div>

    {
      split && (
        <div class="mt-8 min-[1000px]:mt-0">
          {cover ? (
            <Image
              src={cover}
              alt={coverAlt || title}
              widths={[640, 960, 1280, 1600]}
              sizes="(min-width: 1000px) 560px, 100vw"
              loading="eager"
              class="l4s-vt-hero aspect-[4/3] w-full rounded-photo object-cover shadow-lg"
              style={coverPosition ? `object-position:${coverPosition}` : undefined}
            />
          ) : remoteCover ? (
            <Photo
              src={remoteCover}
              alt={remoteCover.alt || coverAlt || title}
              sizes="(min-width: 1000px) 560px, 100vw"
              loading="eager"
              class="l4s-vt-hero aspect-[4/3] w-full rounded-photo object-cover shadow-lg"
            />
          ) : null}
        </div>
      )
    }
  </div>
</header>

{
  hasCover && !split && (
    <div class:list={[bleed ? "mt-8" : "mt-8 px-6"]}>
      <div class:list={["mx-auto w-full", !bleed && container, !bleed && narrow && "[&>*]:max-w-narrow"]}>
        {cover ? (
          <Image
            src={cover}
            alt={coverAlt || title}
            widths={[640, 960, 1440, 1920, 2400]}
            sizes={narrow ? "(min-width: 800px) 760px, 100vw" : "(min-width: 1220px) 1180px, 100vw"}
            loading="eager"
            class:list={["l4s-vt-hero w-full object-cover", frame]}
            style={coverPosition ? `object-position:${coverPosition}` : undefined}
          />
        ) : remoteCover ? (
          <Photo
            src={remoteCover}
            alt={remoteCover.alt || coverAlt || title}
            sizes={narrow ? "(min-width: 800px) 760px, 100vw" : "(min-width: 1220px) 1180px, 100vw"}
            loading="eager"
            class:list={["l4s-vt-hero w-full object-cover", frame]}
          />
        ) : null}
      </div>
    </div>
  )
}
