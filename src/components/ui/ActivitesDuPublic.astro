---
/**
 * Les activités d'un public, en bas de sa page (Michael, 2026-10-23) : la
 * grille se construit depuis le catalogue (`src/lib/publics.ts`), si bien
 * qu'une activité étiquetée pour ce public y apparaît sans retouche de la
 * page. Rien n'est rendu quand le public n'a aucune activité.
 */
import Button from "@components/ds/Button.astro";
import Section from "@components/ds/Section.astro";
import CardGrid from "@components/ui/CardGrid.astro";
import { catalogueItems } from "@lib/catalogue";
import { PUBLICS, type PublicSlug } from "@lib/publics";

interface Props {
  public: PublicSlug;
}

const { public: publicSlug } = Astro.props;
const items = await catalogueItems(publicSlug);
const { label, sectionTitle } = PUBLICS[publicSlug];
---

{
  items.length > 0 && (
    <Section
      id="activites-du-public"
      overline={label}
      title={`${sectionTitle} 🎒`}
      highlight="activités"
      surface="paper"
    >
      <CardGrid items={items} poleHeader />
      <div class="mt-9 flex justify-center">
        <Button variant="secondary" href={`/catalogue?pour=${publicSlug}#activites`}>
          Ces activités dans le catalogue
        </Button>
      </div>
    </Section>
  )
}
