---
/**
 * Card — surface plate à coins de photo (16 px), photo optionnelle en tête,
 * légère élévation au survol (portage de `Card` dans Surfaces.jsx).
 *
 * `href` transforme la carte entière en lien : dans ce cas rien d'interactif ne
 * doit être placé à l'intérieur. Pour une carte cliquable qui garde un titre
 * lié (le cas d'EventCard), laisser `href` vide et poser `l4s-stretch-link` sur
 * le lien du titre.
 *
 * Sans photo, la carte ne réserve JAMAIS un cadre blanc vide : soit elle n'a
 * aucune zone média, soit — quand `pole` est fourni — un bandeau court teinté à
 * la couleur du pôle, portant son pictogramme dans l'encre du pôle.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { pole as resolvePole, type PoleSlug } from "@lib/poles";
import { isRemoteImage, type RemoteImage } from "@lib/remote-image";
import PoleIcon from "./PoleIcon.astro";

type Surface = "white" | "paper" | "subtle" | "teal";

interface Props {
  surface?: Surface;
  /** Image locale optimisée (ImageMetadata), image Claudy rapatriée au build, ou URL servie telle quelle. */
  image?: ImageMetadata | RemoteImage | string;
  imageAlt?: string;
  /** Rapport de la zone photo, en syntaxe CSS ("4/3", "16/9"…). */
  imageAspect?: string;
  /** Largeur d'affichage de la photo, pour que le navigateur choisisse la bonne variante. */
  imageSizes?: string;
  /** `eager` pour une carte visible dès l'arrivée sur la page (première rangée). */
  imageLoading?: "eager" | "lazy";
  /** Sans photo : bandeau teinté du pôle avec son pictogramme, au lieu du vide. */
  pole?: PoleSlug;
  /** Rembourrage interne : pixels (20 dans la référence) ou valeur CSS complète. */
  padding?: number | string;
  hoverable?: boolean;
  href?: string;
  class?: string;
  [key: string]: unknown;
}

const SURFACES: Record<Surface, string> = {
  white: "bg-white border-[1.5px] border-line-soft text-ink",
  paper: "bg-paper text-ink",
  subtle: "bg-surface text-ink",
  teal: "bg-teal text-white",
};

const {
  surface = "white",
  image,
  imageAlt = "",
  imageAspect = "4/3",
  imageSizes = "(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw",
  imageLoading = "lazy",
  pole,
  padding = 20,
  hoverable = false,
  href,
  class: className,
  ...rest
} = Astro.props;

const classes = [
  "relative block overflow-hidden rounded-photo no-underline",
  SURFACES[surface],
  hoverable
    ? "transition-[transform,box-shadow] duration-200 ease-[cubic-bezier(0.2,0.7,0.2,1)] hover:-translate-y-0.5 hover:shadow-md focus-within:shadow-md"
    : "",
  className,
];

// Variantes de 400 à 1280 px, jamais au-delà de l'original : une carte de
// 380 px n'a pas à télécharger une photo de 2 000 px.
const widthsFor = (img: ImageMetadata): number[] => {
  const ws = [400, 640, 960, 1280].filter((w) => w < img.width);
  return ws.length > 0 ? ws : [img.width];
};

const Tag = href ? "a" : "div";
const hasImage = Boolean(image) || Astro.slots.has("image");
// Repli sans photo : le bandeau du pôle. Jamais de cadre blanc vide.
const fallbackPole = !hasImage && pole ? resolvePole(pole) : undefined;
---

<Tag class:list={classes} data-l4s-card {...href ? { href } : {}} {...rest}>
  {
    hasImage ? (
      <div class="w-full overflow-hidden bg-surface" style={`aspect-ratio:${imageAspect}`}>
        {isRemoteImage(image) ? (
          <img
            src={image.src}
            srcset={image.srcset}
            sizes={imageSizes}
            width={image.width}
            height={image.height}
            alt={imageAlt}
            loading={imageLoading}
            decoding="async"
            class="h-full w-full object-cover"
          />
        ) : image && typeof image !== "string" ? (
          <Image
            src={image}
            alt={imageAlt}
            widths={widthsFor(image)}
            sizes={imageSizes}
            loading={imageLoading}
            class="h-full w-full object-cover"
          />
        ) : image ? (
          <img src={image} alt={imageAlt} loading="lazy" decoding="async" class="h-full w-full object-cover" />
        ) : (
          <slot name="image" />
        )}
      </div>
    ) : fallbackPole ? (
      <div
        class:list={["flex h-[120px] w-full items-center justify-center", fallbackPole.classes.bgTint]}
        aria-hidden="true"
      >
        <PoleIcon pole={fallbackPole.slug} class:list={["h-12", fallbackPole.classes.textInk]} />
      </div>
    ) : null
  }
  <div style={`padding:${typeof padding === "number" ? `${padding}px` : padding}`}>
    <slot />
  </div>
</Tag>
