---
/**
 * Section — bande horizontale du site (portage de `Section` dans shared.jsx).
 * Beaucoup de blanc, une seule colonne, 1180 px. En `narrow`, la colonne de
 * lecture fait 760 px mais reste calée sur le bord gauche du site — le même que
 * le logo de l'en-tête, les bandes et le pied de page : une seule grille.
 * Le titre h2 porte, par convention de la charte, un emoji en fin de ligne
 * (« Nos projets 🎴 ») : il est passé tel quel dans `title`.
 *
 * Inspiration semisto.org : un `overline` (surtitre court en capitales) peut
 * précéder le titre, et `align="center"` centre l'en-tête de section (le
 * contenu, lui, garde sa grille). Le contenu apparaît en fondu léger quand la
 * section entre à l'écran (`.l4s-reveal`, global.css).
 */
import Highlight from "./Highlight.astro";

type Surface = "transparent" | "paper" | "subtle" | "teal";

interface Props {
  title?: string;
  /** Mot-clé du titre à surligner en jaune (motif 3) ; il doit figurer tel quel dans `title`. */
  highlight?: string;
  surface?: Surface;
  narrow?: boolean;
  /** Surtitre court au-dessus du titre (« Agenda », « Le lieu »). */
  overline?: string;
  /** Centre le surtitre et le titre (sections d'accueil). */
  align?: "start" | "center";
  /** Identifiant d'ancre (« #agenda »). */
  id?: string;
  class?: string;
}

const SURFACES: Record<Surface, string> = {
  transparent: "bg-transparent text-ink",
  paper: "bg-paper text-ink",
  subtle: "bg-surface text-ink",
  teal: "bg-teal text-white",
};

const {
  title,
  highlight,
  overline,
  align = "start",
  surface = "transparent",
  narrow = false,
  id,
  class: className,
} = Astro.props;
const centered = align === "center";
// Le mot-clé absent du titre ne surligne rien : le titre reste entier.
const at = title && highlight ? title.indexOf(highlight) : -1;
const parts =
  title && highlight && at >= 0
    ? [title.slice(0, at), highlight, title.slice(at + highlight.length)]
    : undefined;
---

<section
  id={id}
  class:list={[
    "px-6 py-[clamp(40px,7vw,64px)]",
    SURFACES[surface],
    className,
  ]}
>
  <div class:list={["l4s-reveal mx-auto w-full max-w-site", narrow && "[&>*]:max-w-narrow"]}>
    {
      overline && (
        <p
          class:list={[
            "l4s-section-overline mb-3",
            centered && "is-centered",
            surface === "teal" && "is-on-teal",
          ]}
        >
          {overline}
        </p>
      )
    }
    {
      title && (
        <h2
          class:list={[
            "font-display text-h2 font-bold",
            centered ? "mx-auto mb-10 max-w-[22ch] text-center" : "mb-7",
            surface === "teal" ? "text-white" : "text-ink",
          ]}
        >
          {parts ? (
            // Sur une seule ligne : un retour entre les morceaux deviendrait une
            // espace avant la virgule de « Hébergements, salles… ».
            <>{parts[0]}<Highlight>{parts[1]}</Highlight>{parts[2]}</>
          ) : (
            title
          )}
        </h2>
      )
    }
    <slot />
  </div>
</section>
