---
/**
 * NewsletterBand — la bande newsletter au-dessus du pied de page, présente sur
 * toutes les pages (sauf /newsletter, qui EST le formulaire).
 *
 * Bande centrée (inspirée de semisto.org) : surtitre, titre avec son emoji et
 * les deux phrases du site sur la newsletter, puis le vrai formulaire Tally
 * (e-mail, thématiques, consentement) — celui de la page /newsletter — posé
 * dans une carte blanche.
 *
 * L'iframe est chargée paresseusement (`loading="lazy"`) : rien n'est demandé
 * à Tally tant que la bande n'approche pas de l'écran. Le script `embed.js` de
 * Tally ajuste la hauteur de l'iframe au contenu (`dynamicHeight=1`) ; sans
 * lui, la hauteur de départ ci-dessous suffit à afficher le formulaire entier.
 * Sans JavaScript, l'iframe se charge quand même (elle a un `src`).
 */
import Section from "./Section.astro";

const FORM_ID = "mK6Nx7";
const embedSrc = `https://tally.so/embed/${FORM_ID}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1`;
---

<Section surface="subtle" id="newsletter">
  {/* Centrée comme celle de semisto.org : titre, deux phrases, puis le
      formulaire posé dans une carte blanche. */}
  <div class="mx-auto max-w-[680px] text-center">
    <p class="l4s-section-overline is-centered mb-3">Newsletter</p>
    <h2 class="font-display text-h2 font-bold">La newsletter des 4 Sources 🗞️</h2>
    <p class="mx-auto mt-4 max-w-[52ch] font-body text-lead text-ink">
      Pour être informé·e des prochains événements aux 4 Sources, <b
        >inscris-toi à notre newsletter mensuelle</b
      >.
    </p>
    <p class="mx-auto mt-3 max-w-[56ch] font-body text-body text-ink-2">
      Nous envoyons un e-mail chaque début de mois, avec des informations sur la vie du lieu et
      les prochains événements que nous organisons.
    </p>
  </div>

  <div class="mx-auto mt-9 max-w-[640px] rounded-xl bg-white p-6 text-left shadow-md sm:p-8">
    <iframe
      src={embedSrc}
      title="Inscription à la newsletter des 4 Sources"
      loading="lazy"
      width="100%"
      height="380"
      class="block w-full border-0"
      style="min-height:380px"></iframe>
  </div>
</Section>

<script is:inline src="https://tally.so/widgets/embed.js" defer></script>
